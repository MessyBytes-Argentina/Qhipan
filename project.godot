; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Qhipan"
config/version="1.1"
run/main_scene="uid://d1qns2ftphyp6"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/image="uid://dn8lpixxsjk3g"
config/icon="uid://bl5tesrbned68"
config/windows_native_icon="res://favicon.ico"

[audio]

buses/default_bus_layout="uid://c5ealkxrsd0ur"

[autoload]

ButtonSoundManager="*res://GodotObjects/Managers/SoundManager/ButtonSoundManager/ButtonSoundManager.tscn"
MusicManager="*res://GodotObjects/Managers/SoundManager/MusicManager/MusicManager.tscn"
VolumeManager="*res://GodotObjects/Managers/SoundManager/VolumeManager.gd"
PopupManager="*res://GodotObjects/Managers/PopupManager/PopupManager.gd"
LevelManager="*res://GodotObjects/Managers/LevelManager/LevelManager.tscn"
GeneralVariables="*res://GodotObjects/Managers/GeneralVariables/GeneralVariables.gd"

[display]

window/fullsize=false
window/bg_color=Color(0, 0, 0, 1)
window/image="uid://dn8lpixxsjk3g"
window/icon="uid://bl5tesrbned68"
window/windows_native_icon="res://favicon.ico"
window/version="1.0"
window/name="Qhipan"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_resource_groups/plugin.cfg")

[global_group]

SceneManager=""
Checkpoints=""
ResetButton=""
Player=""
Gridmap=""
OnPlayerFan=""
Fog=""
