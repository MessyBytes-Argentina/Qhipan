code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Distortion : hint_range(0, 2) = 0;
uniform bool UseTime = false;
uniform float Speed : hint_range(0, 100) = 1;
uniform float Progress : hint_range(0, 1) = 0;
uniform float ShineAngle : hint_range(0, 360) = 145;
uniform float ShineSize : hint_range(0, 1) = 0.15000000596046;
uniform float Smoothness : hint_range(0, 1) = 0;
uniform vec4 ShineColor : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);



void fragment() {
// FloatParameter:56
	float n_out56p0 = Distortion;


// Input:57
	vec2 n_out57p0 = UV;


// VectorOp:58
	vec2 n_in58p1 = vec2(0.50000, 0.50000);
	vec2 n_out58p0 = n_out57p0 - n_in58p1;
	float n_out58p1 = n_out58p0.r;
	float n_out58p2 = n_out58p0.g;


// FloatFunc:60
	float n_out60p0 = abs(n_out58p1);


// FloatFunc:61
	float n_out61p0 = abs(n_out58p2);


// FloatOp:59
	float n_out59p0 = max(n_out60p0, n_out61p0);


// FloatOp:62
	float n_out62p0 = n_out56p0 * n_out59p0;


// FloatFunc:63
	float n_out63p0 = 1.0 - n_out62p0;


// Reroute:69
	float n_out69p0 = n_out63p0;


// BooleanParameter:47
	bool n_out47p0 = UseTime;


// FloatParameter:46
	float n_out46p0 = Speed;


// Input:51
	float n_out51p0 = TIME;


// FloatOp:50
	float n_out50p0 = n_out46p0 * n_out51p0;


// FloatOp:52
	float n_in52p1 = 1.57100;
	float n_out52p0 = n_out50p0 - n_in52p1;


// FloatFunc:53
	float n_out53p0 = tan(n_out52p0);


// FloatOp:54
	float n_in54p1 = 0.50000;
	float n_out54p0 = n_out53p0 + n_in54p1;


// FloatParameter:3
	float n_out3p0 = Progress;


// Mix:49
	float n_in49p0 = -1.30000;
	float n_in49p1 = 0.00000;
	float n_out49p0 = mix(n_in49p0, n_in49p1, n_out3p0);


	float n_out48p0;
// Switch:48
	n_out48p0 = mix(n_out49p0, n_out54p0, float(n_out47p0));


// VectorCompose:66
	float n_in66p1 = 0.00000;
	vec2 n_out66p0 = vec2(n_out48p0, n_in66p1);


// Input:7
	vec2 n_out7p0 = UV;


// VectorOp:9
	vec2 n_in9p1 = vec2(0.50000, 0.50000);
	vec2 n_out9p0 = n_out7p0 - n_in9p1;


// VectorDecompose:14
	float n_out14p0 = n_out9p0.x;
	float n_out14p1 = n_out9p0.y;


// FloatParameter:5
	float n_out5p0 = ShineAngle;


// FloatFunc:10
	float n_out10p0 = radians(n_out5p0);


// FloatFunc:12
	float n_out12p0 = cos(n_out10p0);


// VectorOp:17
	vec2 n_out17p0 = vec2(n_out14p0) * vec2(n_out12p0);


// FloatFunc:11
	float n_out11p0 = sin(n_out10p0);


// VectorOp:16
	vec2 n_out16p0 = vec2(n_out14p1) * vec2(n_out11p0);


// FloatOp:20
	float n_out20p0 = n_out17p0.x - n_out16p0.x;


// VectorOp:15
	vec2 n_out15p0 = vec2(n_out14p0) * vec2(n_out11p0);


// VectorOp:18
	vec2 n_out18p0 = vec2(n_out14p1) * vec2(n_out12p0);


// VectorOp:19
	vec2 n_out19p0 = n_out15p0 + n_out18p0;


// VectorCompose:21
	vec2 n_out21p0 = vec2(n_out20p0, n_out19p0.x);


// VectorOp:23
	vec2 n_in23p1 = vec2(0.50000, 0.50000);
	vec2 n_out23p0 = n_out21p0 + n_in23p1;


// VectorOp:65
	vec2 n_out65p0 = n_out66p0 + n_out23p0;
	float n_out65p1 = n_out65p0.r;


// FloatFunc:67
	float n_out67p0 = abs(n_out65p1);


// FloatOp:68
	float n_out68p0 = n_out69p0 * n_out67p0;


// FloatFunc:70
	float n_out70p0 = sqrt(n_out68p0);


// FloatParameter:4
	float n_out4p0 = ShineSize;


// FloatParameter:72
	float n_out72p0 = Smoothness;


// Clamp:73
	float n_in73p1 = 0.00100;
	float n_in73p2 = 1.00000;
	float n_out73p0 = clamp(n_out72p0, n_in73p1, n_in73p2);


// FloatOp:74
	float n_out74p0 = n_out4p0 + n_out73p0;


// FloatOp:76
	float n_out76p0 = n_out70p0 - n_out74p0;


// FloatOp:75
	float n_out75p0 = n_out4p0 - n_out73p0;


// FloatOp:77
	float n_out77p0 = n_out75p0 - n_out74p0;


// FloatOp:78
	float n_out78p0 = n_out76p0 / n_out77p0;


// ColorParameter:94
	vec4 n_out94p0 = ShineColor;


// VectorOp:81
	vec4 n_out81p0 = vec4(n_out78p0) * n_out94p0;
	float n_out81p4 = n_out81p0.a;


// Compare:91
	float n_in91p1 = 0.00000;
	bool n_out91p0 = n_out81p4 > n_in91p1;


// Input:86
	vec4 n_out86p0 = COLOR;
	float n_out86p4 = n_out86p0.a;


// Compare:95
	float n_in95p1 = 0.00000;
	bool n_out95p0 = n_out86p4 > n_in95p1;


	bool n_out96p0;
// Switch:96
	bool n_in96p2 = false;
	if (n_out91p0) {
		n_out96p0 = n_out95p0;
	} else {
		n_out96p0 = n_in96p2;
	}


// VectorOp:90
	vec4 n_out90p0 = n_out81p0 + n_out86p0;


// Reroute:92
	vec4 n_out92p0 = n_out86p0;


	vec4 n_out89p0;
// Switch:89
	n_out89p0 = mix(n_out92p0, n_out90p0, float(n_out96p0));
	float n_out89p1 = n_out89p0.r;
	float n_out89p2 = n_out89p0.g;
	float n_out89p3 = n_out89p0.b;
	float n_out89p4 = n_out89p0.a;


// VectorCompose:93
	vec3 n_out93p0 = vec3(n_out89p1, n_out89p2, n_out89p3);


// Output:0
	COLOR.rgb = n_out93p0;
	COLOR.a = n_out89p4;


}
